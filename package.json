{
  "name": "@innovixx/payload-color-picker-field",
  "version": "2.0.4",
  "homepage:": "https://innovixx.co.uk",
  "repository": "git@github.com:Innovixx-Development/payload-color-picker-field.git",
  "description": "The Payload Color Picker that enables an easy color selection field for your Payload projects.",
  "type": "module",
  "scripts": {
    "build": "tsc && pnpm copy:scss",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint ./src/**/*.{js,jsx,ts,tsx}",
    "lint:fix": "eslint --fix --ext .ts,.tsx src",
    "copy:scss": "copyfiles -u 1 \"src/**/*.scss\" dist",
    "watch": "nodemon --watch src -e ts,tsx,scss --exec \"pnpm build\""
  },
  "keywords": [
    "payload",
    "cms",
    "field",
    "plugin",
    "typescript",
    "react",
    "color",
    "picker"
  ],
  "author": "support@innovixx.co.uk",
  "license": "MIT",
  "peerDependencies": {
    "next": "^16.0.0",
    "payload": "^3.74.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@innovixx/stylelint-config": "^1.0.8",
    "@payloadcms/eslint-config": "^3.28.0",
    "@payloadcms/eslint-plugin": "^3.28.0",
    "@payloadcms/next": "^3.83.0",
    "@payloadcms/translations": "^3.83.0",
    "@payloadcms/ui": "^3.83.0",
    "@types/node": "^25.6.0",
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0-rc.1",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "8.58.2",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "next": "^16.2.4",
    "nodemon": "^3.1.14",
    "payload": "^3.83.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "stylelint": "^17.8.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.0.0",
    "ts-essentials": "^10.1.1",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    }
  },
  "dependencies": {
    "react-colorful": "^5.6.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "npm:types-react@19.0.0-rc.1",
      "@types/react-dom": "npm:types-react-dom@19.0.0-rc.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "overrides": {
    "@types/react": "npm:types-react@19.0.0-rc.1",
    "@types/react-dom": "npm:types-react-dom@19.0.0-rc.1"
  }
}